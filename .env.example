# ==============================================================================
# EduPulse AI — Environment Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# DO NOT COMMIT SENSITIVE SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Database Connection (Default: local SQLite database)
# For managed PostgreSQL: postgresql://username:password@hostname:5432/classroom_analytics
DATABASE_URL=sqlite:///./classroom_analytics.db

# File System Directories
MODEL_DIR=ml/models
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed

# Automated Background Recomputation Interval (Seconds)
RECOMPUTE_INTERVAL_SECONDS=3600

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Port
PORT=8000

# Frontend API Configuration (Leave blank for same-origin relative /api calls)
# VITE_API_URL=http://localhost:8000
